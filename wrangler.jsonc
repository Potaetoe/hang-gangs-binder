{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hang-gangs-binder",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	// Brute-force defence for the sign-in and register forms. The
	// dashboard's rate-limiting rules are scoped to a DOMAIN, and this
	// site answers on workers.dev, which is not one we own - so the
	// limiting lives in the Worker instead, where it works regardless
	// (security pass, 2026-08-24). period must be 10 or 60.
	"ratelimits": [
		{
			"name": "LOGIN_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 6, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "binder-db",
			"database_id": "9eb1b7e9-11a1-4329-bb7b-f770636ce3d1",
			"migrations_dir": "drizzle"
		}
	]
}
