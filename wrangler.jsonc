{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hang-gangs-binder",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	// Crash lines only. Invocation logs stay off because they would store
	// request URLs, and the Telegram sign-in carries a member's name in
	// one. So Workers Logs holds only what the app logs itself: an
	// unexpected error's route and message (hooks.server.ts handleError).
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	// The brake on password guessing (src/lib/server/auth/throttle.ts).
	// Dashboard rate limits need a domain we own and workers.dev is not
	// one, so the limit lives in the Worker. period must be 10 or 60.
	"ratelimits": [
		{
			"name": "LOGIN_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 6, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "binder-db",
			"database_id": "9eb1b7e9-11a1-4329-bb7b-f770636ce3d1",
			"migrations_dir": "drizzle"
		}
	]
}
