# Local development values - copy to .dev.vars (gitignored) and adjust.
# Nothing here is a real secret; the e2e suite signs its Telegram
# fixtures with this bot token and expects these allow-list ids. CI
# copies this file as-is.
#
# 7000001 is the ordinary Telegram member; 7000002 belongs to the
# replay test, which needs an identity of its own so it cannot race
# the first one over a shared display name. 7000004 belongs to the
# operator-escape-hatch test, for the same no-racing reason.
ID_SECRET=local-id-secret
DIRECTORY_SECRET=local-dir-seal
TELEGRAM_BOT_TOKEN=local-test-bot-token
# The widget only renders when the bot has a username - and the door
# only sets its anti-CSRF state cookie when the widget renders, so the
# e2e telegram walks need this set (finding 3, 2026-08-26).
TELEGRAM_BOT_USERNAME=local_test_bot
TELEGRAM_ALLOW_IDS=7000001,7000002,7000003,7000004
TEST_HOOKS=1
