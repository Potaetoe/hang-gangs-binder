# Editor defaults, so a file does not change shape depending on who opened
# it. This is the half of consistency that runs before any linter does.
#
# Kept deliberately small: it covers whitespace and nothing else. Style
# that a machine should argue about lives in eslint.config.js and
# pyproject.toml, where it can fail a build instead of relying on an
# editor being configured.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# JavaScript, HTML, CSS, JSON, YAML: two spaces, matching what apps/web
# already is.
[*.{js,mjs,html,css,json,yml,yaml,svg}]
indent_size = 2

# Python: four, per PEP 8 and what tools/ already is.
[*.py]
indent_size = 4

# Markdown: trailing spaces can be a deliberate line break, so leave them.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# The cmd half of the launcher, and the one place the [*] rule above is
# wrong. .gitattributes pins *.cmd to eol=crlf because cmd.exe misparses
# multi-line blocks under LF; without this section an editor obeying
# end_of_line = lf saves the file in the shape that breaks it, and it
# stays broken until the next checkout converts it back. The two files
# are held to the same answer by dev/build_web.test.mjs, which reads
# both - the disagreement stood because nothing compared them.
[*.cmd]
end_of_line = crlf

[Makefile]
indent_style = tab
