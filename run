#!/bin/sh
# One entry point for the Python-based tooling, because `python` on the
# owner's machine is a Microsoft Store stub and the real interpreter
# answers to `py -3`. Finds a working Python once, then dispatches.
# Windows shells get the same commands from run.cmd (`.\run <command>`).
set -eu
cd "$(dirname "$0")"

find_python() {
  for cand in "py -3" python3 python; do
    if $cand --version >/dev/null 2>&1; then
      printf '%s' "$cand"
      return 0
    fi
  done
  return 1
}

PY=$(find_python) || {
  echo "No working Python found (the Microsoft Store stub does not" >&2
  echo "count). Install one from python.org or enable the py launcher." >&2
  exit 1
}

case "${1:-}" in
  check)
    exec $PY tools/check.py ;;
  gate)
    # The 0.9 gate (tests/run.mjs) - see its own header for the whole
    # argument, including the preflight seam that is its stage zero.
    # `check` above is the OLD gate (tools/check.py): the two run side
    # by side under the #228 ruling until `check` has no surfaces left
    # to guard, and each is its own verb rather than one calling the
    # other so a red in either names itself without guessing which
    # apparatus it came from. Node rather than $PY: tests/run.mjs is
    # the runner every arm here answers to, and it is JavaScript.
    exec node tests/run.mjs ;;
  docs)
    exec $PY tools/check_docs.py ;;
  build)
    # Write dist/: apps/web with the comments taken out of the CSS and
    # the scripts (#181). Node rather than $PY because the JavaScript
    # half is parsed with acorn - a "/*"
    # inside a string or a regex literal is not a comment, and a scanner
    # that thinks it is ships corrupted code.
    #
    # dist/ is COMMITTED, so this is a verb you run and then read the
    # diff of, not a step that happens on the way to a release. `./run
    # check` refuses a dist/ that is not what apps/web builds to, in
    # both directions.
    exec node tools/build_web.mjs ;;
  live)
    # The answer to "what has never been tried against a running
    # system" (#157). Read-only and offline: it reads the ledger, the
    # router and wrangler.toml, and it contacts nothing. The probing
    # itself is a separate, owner-only act - see the report's own
    # closing lines for why.
    exec $PY tools/check_live.py --report ;;
  serve)
    echo "Open http://127.0.0.1:8124  (127.0.0.1, not localhost - #72)"
    exec $PY -m http.server 8124 --directory apps/web ;;
  serve-root)
    echo "Site at http://127.0.0.1:8124/apps/web/, harness under /dev/,"
    echo "key tools under /tools/"
    exec $PY -m http.server 8124 --directory . ;;
  keygen)
    echo "Open http://127.0.0.1:8125/keygen.html"
    exec $PY -m http.server 8125 --directory tools ;;
  demo)
    # Node rather than $PY: this one is not a static server. It mirrors
    # apps/web with the demo's declared edits applied on the way out, which
    # http.server has no way to do. dev/demo-server.mjs says why the
    # mirror exists.
    echo "Open http://127.0.0.1:8126/  (127.0.0.1, not localhost - #72)"
    # Shifted so `./run demo --port 8160` passes the port through and not
    # the verb. The override exists for parallel agent sessions, whose
    # preview blocks must not take the port the owner's demo answers on.
    shift
    exec node dev/demo-server.mjs "$@" ;;
  bake)
    # The same demo as static files, for hosting it off this machine
    # (#143). Node for the same reason as demo: it applies the mirror's
    # edits, which nothing static can do.
    #
    # This WRITES A DIRECTORY AND NOTHING ELSE - no upload, no wrangler,
    # no deploy. Putting the output somewhere is a separate act with a
    # separate approval, and dev/README.md carries the steps.
    shift
    exec node dev/demo-bake.mjs "$@" ;;
  session-open)
    # The first act of a session (MAJOR3, #311): two read-only checks,
    # printed for the operator before anything else runs. tools/
    # session_open.py is the whole wiring - see its own module
    # docstring for what it calls and why its exit code is prime_lock's
    # ruled table alone rather than a blend with reaper's.
    exec $PY tools/session_open.py ;;
  fleet-status)
    # The derived orchestration view (0.9-M0-S20, #317): branches,
    # tickets, worktrees and the reaper's own report, each row naming
    # the artifact it came from - Prime's session-open and pre-decision
    # habit, extending session-open above rather than duplicating it
    # (session-open answers "is a lock held and what would the reaper
    # clean up"; this answers "what is the whole fleet doing right
    # now"). tools/fleet_status.py's own module docstring carries the
    # full reasoning.
    exec $PY tools/fleet_status.py ;;
  agent-init)
    # The worktree contract. tools/agent_init.py carries the reasoning -
    # the four traps this exists to kill, why its state is machine-held
    # rather than in the tree, and what the readiness probe does and
    # does not prove. It is the first command to run in a fresh
    # worktree, it is safe on this primary checkout, and it is
    # idempotent.
    #
    # bootstrap below stays and is not folded into it: bootstrap is the
    # one-line answer to a lint stage reporting a missing node_modules,
    # and this is the whole environment. Shifted so `--verify` and
    # `--ports 8150` reach the script rather than the verb.
    shift
    exec $PY tools/agent_init.py init "$@" ;;
  agent-park)
    # The far end of the same contract: the death protocol. It detaches
    # the branch so a landing needs no ref dance, releases the port
    # block, removes the scratch directory and writes the marker a
    # reaper proves this worktree dead from. It refuses on the primary
    # checkout, and it refuses over uncommitted work. Shifted for the
    # same reason as agent-init above, and --verify matters more here:
    # this is the destructive verb, so the flag documented as changing
    # nothing has to change nothing on it.
    shift
    exec $PY tools/agent_init.py park "$@" ;;
  bootstrap)
    # A fresh checkout or worktree has no node_modules, and the gate's
    # eslint stage reports that absence as FAILED - which reads as a
    # broken tree to anyone who has not hit it before. This makes
    # "get gate-ready" one command. --ignore-scripts for the reason
    # deploy.yml states at length: install scripts are the supply
    # chain's favorite door.
    #
    # The probe is the binary the gate runs, not the directory: a
    # worktree warmed by junctioning the primary checkout's
    # node_modules has every package yet fails Git Bash's `-d` (MSYS
    # stats the junction itself, not what it resolves to), and that
    # false negative sends `npm ci` through the junction to tear down
    # the primary checkout's install. Probing through the junction
    # resolves it, and also catches a directory that exists but lost
    # the tool.
    if [ ! -e node_modules/.bin/eslint ]; then
      npm ci --ignore-scripts
    else
      echo "node_modules present - nothing to install"
    fi
    $PY --version && node --version
    echo "gate-ready: ./run check" ;;
  *)
    cat <<'EOF'
usage: ./run <command>          (PowerShell: .\run <command>)

  session-open  the first act of a session: prime_lock.py check against
              this session's own identity (exits per its ruled table -
              0 ok, 1 another session's fresh lock, 2 stale/unreadable)
              and reaper.py --report, both printed for the operator
  fleet-status  the derived orchestration view: branches, tickets,
              worktrees and the reaper's own report, each row naming
              the artifact it came from - consult before every spawn,
              continuation or landing decision (contacts gh; nothing
              else leaves this machine)
  agent-init  make this worktree gate-ready and print the contract you
              are held to: line endings renormalized, dependencies
              installed junction-safely, one real gate stage run as a
              readiness probe, a port block leased, a scratch directory
              outside the tree, and the teardown verb below
              (--verify reports and changes nothing; --ports N asks for
              a block; --reclaim supersedes a lease you have shown dead)
  agent-park  the end of a slice: detach the branch so a landing needs
              no ref dance, release the port block, remove the scratch
              directory, and leave the marker a reaper can prove this
              worktree dead from
              (--verify reports what parking would do and does none of
              it - this verb is destructive, so the dry run is the one
              an unsure agent reaches for)
  bootstrap   make a fresh checkout gate-ready (installs lint deps)
  build       write dist/ - apps/web with the comments taken out
              (committed; `check` refuses a stale one)
  check       run every check the project has - the same set CI runs
  gate        the 0.9 gate (tests/run.mjs) - the new apparatus under
              #228, running beside `check` until it retires
  docs        run only the documentation checks
  live        what has never been exercised against a running system,
              what never can be before production, and what is due
              (reads files only; contacts nothing)
  serve       serve the site at http://127.0.0.1:8124
  serve-root  serve the repository root on 8124 (keycheck, browser checks)
  keygen      serve the key generator at http://127.0.0.1:8125
  demo        drive the site offline on http://127.0.0.1:8126
              (--port N to move it)
  bake        write that same demo to _demo/ as static files, for
              hosting it elsewhere (--out PATH; deploys nothing)
EOF
    exit 2 ;;
esac
