# Python bytecode - generated by the tools in tools/
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local build output
_site/

# The baked demo (#143). Generated by `./run bake` from whatever commit
# is checked out, and stamped with it - so a copy in the history would
# be a second, silently older answer to a question `./run bake` answers
# in seconds. The build is produced on demand, never committed.
_demo/

# Wrangler's working directory - build cache and temporary bundles it
# writes beside the config. Nothing in it is worth keeping and some of
# it is machine-specific.
#
# Note this is NOT where wrangler keeps credentials: the OAuth token
# lives in the user profile, well outside the repository. Which is the
# right side of the line, and worth stating so nobody assumes the
# opposite and starts hunting for a secret to ignore.
.wrangler/

# The fleet's machine-local state - agent worktrees, settings.json /
# settings.local.json, scheduled_tasks.lock. This is how the parallel
# agent sessions are driven on this one machine; none of it describes
# the project and none of it should ever ship. It is also what makes
# `git status --porcelain` non-empty while it sits untracked, which is
# enough to make `./run bake` refuse to stamp a commit against a dirty
# tree - so ignoring it is what lets the bake run at all.
#
# Nothing sensitive is being hidden here either: like .wrangler above,
# no credentials live in this directory. The fleet's secrets live in
# the user profile, outside the repository.
.claude/

# ---------------------------------------------------------------------
# KEYS. Nothing resembling a private key may ever reach a commit.
#
# The admin private key is the only thing standing between the stored
# ciphertext and every submitter's Telegram handle. This repo is public.
# These patterns are a backstop, not the control - the key is meant to
# live outside the repo entirely. See DESIGN.md, "Key custody".
# ---------------------------------------------------------------------
*.key
*.pem
*-private*
secret*

# Node tooling. devDependencies only - nothing here is bundled or
# shipped, and apps/web is copied to the published site verbatim.
node_modules/
